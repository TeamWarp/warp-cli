.SH "SYNOPSIS"
.B warpapi workers create\-contractor
\fB\-\-entity\-type\fR \fI<value>\fR \fB\-\-first\-name\fR \fI<value>\fR \fB\-\-last\-name\fR \fI<value>\fR \fB\-\-position\fR \fI<value>\fR \fB\-\-start\-date\fR \fI<value>\fR \fB\-\-email\fR \fI<value>\fR \fB\-\-department\-id\fR \fI<value>\fR \fB\-\-manager\-id\fR \fI<value>\fR \fB\-\-work\-country\fR \fI<value>\fR [\fIoptions\fR]
