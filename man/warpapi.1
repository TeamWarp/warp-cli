.SH "SHELL COMPLETION"
warpapi completion <shell> prints a completion script for bash, zsh, and fish. Load it from your shell startup file:
.PP
.RS 4
.nf
eval "$(warpapi completion bash)"
eval "$(warpapi completion zsh)"
warpapi completion fish | source
.fi
.RE
