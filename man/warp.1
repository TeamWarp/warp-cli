.SH "SHELL COMPLETION"
warp completion <shell> prints a completion script for bash, zsh, and fish. Load it from your shell startup file:
.PP
.RS 4
.nf
eval "$(warp completion bash)"
eval "$(warp completion zsh)"
warp completion fish | source
.fi
